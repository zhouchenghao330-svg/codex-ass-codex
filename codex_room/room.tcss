Screen {
    background: #1e211f;
    color: #dad8ce;
    min-width: 60;
}
Screen > .screen--selection { background: #e9dfb8; color: #20251f; }

#workspace { height: 1fr; }
#main { width: 1fr; padding: 1 2 0 2; }
#timeline {
    height: 1fr;
    padding: 0 1 0 0;
    scrollbar-size: 1 1;
    scrollbar-color: #454c43;
    scrollbar-background: #1e211f;
}
.message { height: auto; margin: 0 0 1 0; padding: 0; }
.message.you { background: #2d322d; padding: 0 1; }
.message.agent { padding: 0 1; }
.message.system { color: #788274; }
.message-header, .message-body { height: auto; }
.message.agent > .message-header { height: 1; }
.working-status { height: 1; color: #93988e; }
.work-summary { height: 1; margin-top: 1; color: #93988e; }

#completion-list {
    display: none;
    overlay: screen;
    width: 72;
    max-width: 100%;
    height: 5;
    padding: 0 1;
    border: round #657359;
    background: #242c21;
    scrollbar-size: 1 1;
}
#completion-list > .option-list--option-highlighted {
    background: #3c4b32;
    color: #edf1e7;
    text-style: bold;
}
#completion-list > .option-list--option-hover { background: #343f2c; }

#composer {
    height: 3;
    background: #2d322d;
    padding: 1 1;
    margin: 1 0 0 0;
}
#prompt { width: 2; height: 1; color: #e3e7de; }
#message-input {
    width: 1fr; height: 1;
    padding: 0; border: none;
    background: transparent; color: #dad8ce;
    scrollbar-size: 1 1;
    overflow-x: hidden;
    scrollbar-color: #657359;
    scrollbar-background: #2d322d;
}
#message-input:focus { border: none; background: transparent; }
#message-input .text-area--placeholder { color: #93988e; }
#message-input .text-area--selection { background: #e9dfb8; color: #20251f; }
#footer { height: 1; color: #919988; }
#recipient { width: 1fr; height: 1; }
#connection { width: 18; height: 1; text-align: right; color: #818a78; }
#toggle-sidebar {
    width: 8; min-width: 8; height: 1;
    margin-right: 1;
    border: none; padding: 0; background: transparent; color: #a1aa95;
}
#toggle-sidebar:hover { background: #343b32; color: #e3e7de; }

#sidebar {
    display: none;
    width: 24;
    padding: 1 1 0 1;
    border-right: solid #394135;
}
#members-heading { height: 2; }
#members-label { width: 1fr; color: #a1aa95; }
#member-count { width: 3; color: #788274; }
#close-sidebar {
    width: 2; min-width: 2; height: 1;
    border: none; padding: 0; background: transparent; color: #a1aa95;
}
#members { height: 1fr; scrollbar-size: 1 1; }
#all-messages {
    width: 100%; height: 1; min-width: 0;
    border: none; padding: 0; margin-bottom: 1;
    background: transparent; color: #a1aa95; content-align: left middle;
}
#all-messages:hover { background: #2a3128; }
#all-messages.selected { background: #30372f; color: #e3e7de; }
.member { height: auto; min-height: 3; margin-bottom: 1; }
.member:hover { background: #2a3128; }
.member.selected { background: #30372f; }
#add-member {
    width: 100%; height: 1;
    border: none; padding: 0; margin: 1 0;
    background: transparent; color: #a1aa95;
}
#add-member:hover { background: #343b32; }

ModalScreen { align: center middle; background: #10140f 75%; }
#dialog, #help-dialog {
    width: 64; height: auto; max-width: 95%; max-height: 95%;
    background: #242b22; border: round #6c7863;
    padding: 1 3 2 3;
}
#dialog-title { height: 2; color: #e8edf5; }
.muted { height: auto; color: #8c9583; }
.field-label { height: 1; margin: 1 0 0 0; color: #a1aa95; }
#dialog Input { margin: 0; border: tall #454f3e; background: #1d211e; }
#dialog Input:focus { border: tall #9eae8e; }
#dialog-error { height: 2; color: #e8b878; }
#dialog-actions { height: 3; align-horizontal: right; }
#dialog-actions Button { margin-left: 1; }
#dialog Select { margin: 0 0 1 0; }
#new-color { height: 1; }
#color-preview { height: 1; padding: 0 1; }
#dialog.add-member-dialog Input { height: 1; border: none; padding: 0 1; }
#dialog.add-member-dialog Input:focus { border: none; background: #30372f; }
#request-details { height: auto; max-height: 16; margin-bottom: 1; }
.field-question { height: auto; margin-top: 1; }
#help-dialog { width: 74; }
#help-copy { height: auto; margin: 0 0 1 0; }
Button { background: #343d2e; color: #d1d4cd; }
Button.-primary { height: 3; background: #a5b797; color: #151b11; border: round #a5b797; content-align: center middle; }
Button.-primary:hover { background: #bdcdb1; }

Screen.narrow #sidebar { width: 22; }
Screen.narrow #main { padding: 0 1; }
